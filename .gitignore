# Secrets
.env
.env.*
# Per-site secrets and server state (sites/<site>/): FTP login, admin recovery password,
# first database, deploy state, local database, home page pictures (taken from the store's site)
sites/*/.env
sites/*/config.local.php
sites/*/live-initial.db
sites/*/.deploy-state.json
sites/*/data/
sites/*/hero/*

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/

# Real shop inventory: never in the public repo
gun_specs.db
seed_inventory.sql
inventory_lines.txt
inventory_import_review.csv
build_inventory.py
*.db
*.db-journal
*.db-wal
*.db-shm

# Server-side data, uploads and secrets
config.local.php
public/data/*
!public/data/.htaccess
public/photos/*
!public/photos/.gitkeep
backups/

# Deploy state, first-deploy database, server config
deploy/.deploy-state.json

# Old inventory import (kept locally for reference)
archive/

# Manufacturer stock photos (copyrighted): deployed to the site, not in the public repo
public/stock-photos/*
!public/stock-photos/.htaccess
!public/photos/.htaccess

# Photos taken from the store's own website for the demo (not for the public repo)
public/assets/hero/*
